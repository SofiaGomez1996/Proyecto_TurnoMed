not** invent changes beyond what the diff describes."),e.hasAddedNode&&t.paragraph("**Added elements.** For new elements, use the **Reference** JSON as a guide for structure and props. Use existing components and patterns from the codebase where possible. **Asset images** may be attached\u2014one per image ref, keyed by the hash in **Image ref(s)**. For each image, **import** it (e.g. `import myImage from 'figma:asset/<hash>.png'`) and use the **imported variable** in `src={myImage}`. Do **not** put the `figma:asset/...` URL directly in `src=\"...\"`."),(e.hasAddedNode||e.hasRemovedNode)&&t.paragraph("**Preserve rendering patterns.** If elements in the target area are rendered from data (e.g. `.map()` over an array, loops), modify the data source or rendering logic rather than replacing it with hardcoded elements. When the diff shows multiple individual elements added or removed at the same source location, the intent is usually to change the underlying data or filter\u2014not to rewrite the rendering into static markup.")}(S,T,t),function(e,t,r,n){for(let N of u){let u=r.get(N);if(u?.length)for(let r of(t.h2(c[N]),u)){var o,s,d,p,E,C,j,S;let u=r[0];if(u)if(1===r.length)switch(N){case i.Y7.Color:o=e,s=t,d=u,p=n,d.targetKind!==i.$6.Prop?console.warn("Color change target kind is not prop",d):(s.h3(m(o,(0,l.rc)(d),d,p)),x(s,d));break;case i.Y7.Content:h(e,t,u,n);break;case i.Y7.Layout:g(e,t,u,n);break;case i.Y7.Typography:E=e,C=t,j=u,S=n,j.targetKind!==i.$6.Prop?console.warn("Typography change target kind is not prop",j):(C.h3(m(E,(0,l.b8)(j.propName),j,S)),x(C,j));break;default:!function(e,t,r,n){let a,l=b(r),o=k(r),s=w(r),d=e.changePrefix();if(r.op===i.vZ.Removed){let e=s??o;d+=`${l} removed${e?` (was \`${e}\`)`:""}`}else r.op===i.vZ.Modified&&void 0!==s&&void 0!==o?d+=`${l}: \`${s}\` \u{2192} \`${o}\``:r.op===i.vZ.Added&&void 0!==o?d+=`${l} set to \`${o}\``:r.op===i.vZ.Moved&&void 0!==r.oldPosition&&void 0!==r.newPosition?(d+=`${l} moved (position \`${r.oldPosition}